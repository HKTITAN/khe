  "typeface":
    "sans": "Inter, system-ui, sans-serif"
    "mono": "\"Geist Mono\", ui-monospace, monospace"
    "hand": "\"Nothing You Could Do\", \"Segoe Print\", cursive"
  "size":
    "12": "0.75rem"
    "13": "0.8125rem"
    "14": "0.875rem"
    "16": "1rem"
    "18": "1.125rem"
    "22": "1.375rem"
    "32": "2rem"
  "radius":
    "6": "6px"
    "8": "8px"
    "12": "12px"
    "full": "999px"
  "spring":
    "smooth": { stiffness: 260, damping: 32 }
    "snappy": { stiffness: 500, damping: 30 }
    "bouncy": { stiffness: 380, damping: 16 }
  "ease":
    "snappy-out": "cubic-bezier(0.19, 1, 0.22, 1)"
    "quick-out": "cubic-bezier(0, 0, 0.2, 1)"
    "swift-out": "cubic-bezier(0.175, 0.885, 0.32, 1.1)"
    "overshoot-out": "cubic-bezier(0.175, 0.885, 0.32, 1.275)"
    "in-out-cubic": "cubic-bezier(0.645, 0.045, 0.355, 1)"

